# Copy this file to .env for local development, or set these as real
# environment variables in your deployment platform (e.g. Render's dashboard).

# Required in production. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# Set to "production" on your deployed environment. Enables HTTPS-only
# cookies, HSTS, and enforces that SECRET_KEY must be set.
FLASK_ENV=development

# Optional. Defaults to a local SQLite file if unset.
# On Render with a managed Postgres add-on, this would look like:
#   postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Optional. Render sets PORT automatically; only needed for manual runs.
PORT=5000
